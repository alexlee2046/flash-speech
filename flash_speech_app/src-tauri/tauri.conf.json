{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:1421",
    "distDir": "../dist"
  },
  "package": {
    "productName": "FlashSpeech",
    "version": "2.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "show": true,
        "hide": true,
        "setPosition": true,
        "setSize": true,
        "setFocus": true,
        "close": true
      },
      "globalShortcut": { "all": true }
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "bundle": {
      "active": true,
      "macOS": {
        "entitlements": "entitlements.plist",
        "exceptionDomain": "",
        "frameworks": [
          "Frameworks/libonnxruntime.1.17.1.dylib",
          "Frameworks/libonnxruntime.dylib",
          "Frameworks/libsherpa-onnx-c-api.dylib",
          "Frameworks/libsherpa-onnx-cxx-api.dylib"
        ],
        "providerShortName": "PM6M3M34BA",
        "signingIdentity": "Developer ID Application: Guangdong Mifeng Intelligent Technology Co., Ltd. (PM6M3M34BA)"
      },
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.flashspeech.assistant",
      "targets": "all"
    },
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "height": 64,
        "label": "main",
        "skipTaskbar": true,
        "title": "FlashSpeech HUD",
        "transparent": true,
        "width": 176
      }
    ]
  }
}