{
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "",
    "devPath": "http://localhost:1421",
    "distDir": "../dist"
  },
  "package": {
    "productName": "flash-speech",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": true
    },
    "bundle": {
      "active": true,
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.flashspeech.assistant",
      "targets": "all"
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "alwaysOnTop": true,
        "center": true,
        "decorations": false,
        "height": 120,
        "label": "main",
        "skipTaskbar": true,
        "title": "FlashSpeech HUD",
        "transparent": true,
        "width": 600
      }
    ]
  }
}